// Buyontime database schema.
// Money is stored as integer paise (₹1 = 100 paise) everywhere to avoid floating-point errors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  ADMIN
  SUPPLIER
  CUSTOMER
}

enum AccountStatus {
  ACTIVE
  BLOCKED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum PaymentOption {
  ONLINE_ONLY
  COD_ONLY
  ONLINE_AND_COD
}

enum PaymentMethod {
  ONLINE
  COD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RTO
  RETURN_REQUESTED
  RETURNED
}

enum StockState {
  NONE
  RESERVED
  COMMITTED
  RELEASED
}

enum InventoryPolicy {
  RESERVE_AT_CHECKOUT
  DEDUCT_ON_PAYMENT
}

enum MixedCartPolicy {
  SPLIT_ORDERS
  BLOCK
}

enum InventoryMovementType {
  ADJUSTMENT
  RESERVE
  RELEASE
  RETURN_RESELLABLE
  RETURN_DAMAGED
  RETURN_TO_SUPPLIER
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUND_INITIATED
  REFUNDED
}

enum ReturnCondition {
  RESELLABLE
  DAMAGED
  RETURN_TO_SUPPLIER
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum RefundMode {
  RAZORPAY
  MANUAL
}

enum ReconciliationStatus {
  UNCHECKED
  OK
  MISMATCH
  RESOLVED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum NotificationAudience {
  CUSTOMER
  ADMIN
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NoteType {
  NOTE
  COMPLAINT
  SUPPORT
}

enum NoteStatus {
  OPEN
  RESOLVED
}

enum GstMode {
  NOT_REGISTERED
  REGISTERED
}

// ─────────────────────────────── Identity ───────────────────────────────

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  phone            String?
  passwordHash     String
  role             Role          @default(CUSTOMER)
  status           AccountStatus @default(ACTIVE)
  avatarUrl        String?
  dateOfBirth      DateTime?
  gender           String?
  emailOptIn       Boolean       @default(true)
  smsOptIn         Boolean       @default(false)
  whatsappOptIn    Boolean       @default(false)
  codBlocked       Boolean       @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessions         Session[]
  resetTokens      PasswordResetToken[]
  addresses        Address[]
  cart             Cart?
  orders           Order[]
  payments         Payment[]
  reviews          Review[]
  wishlist         WishlistItem[]
  notifications    Notification[]
  notesAbout       CustomerNote[] @relation("NoteCustomer")
  notesWritten     CustomerNote[] @relation("NoteAuthor")
  auditLogs        AuditLog[]
  returns          ReturnRequest[]
  productViews     ProductView[]
  couponUsages     CouponUsage[]

  @@index([role, createdAt])
  @@index([phone])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([pincode])
}

// ─────────────────────────────── Catalogue ───────────────────────────────

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?
  imageUrl     String?
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  products     Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  sku                String          @unique
  brand              String?
  description        String
  categoryId         String?
  category           Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status             ProductStatus   @default(DRAFT)
  paymentOption      PaymentOption   @default(ONLINE_AND_COD)
  /// Selling price in paise, GST inclusive.
  price              Int
  /// Maximum retail price in paise.
  mrp                Int
  /// What the product costs me (purchase price) in paise.
  costPrice          Int             @default(0)
  /// My forward shipping cost per unit in paise (for profit, not charged to customer).
  shippingCost       Int             @default(0)
  /// Packaging or other per-unit costs in paise.
  otherCost          Int             @default(0)
  /// GST rate in percent, e.g. 5, 12, 18.
  gstRate            Int             @default(0)
  lowStockThreshold  Int             @default(5)
  specs              Json            @default("[]")
  isFeatured         Boolean         @default(false)
  sourceName         String?
  sourceReference    String?
  ratingAvg          Float           @default(0)
  ratingCount        Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  images             ProductImage[]
  variants           ProductVariant[]
  reviews            Review[]
  wishlist           WishlistItem[]
  orderItems         OrderItem[]
  views              ProductView[]

  @@index([status, categoryId])
  @@index([status, createdAt])
  @@index([status, isFeatured])
  @@index([brand])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  /// Storage provider key (Cloudinary public_id or local path) for deletion.
  storageKey String?
  alt        String?
  /// 0 = primary image.
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId, position])
}

/// Every product has at least one variant. Simple products have a single default variant.
/// Stock lives on the variant — this is the product inventory record.
model ProductVariant {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String    @default("Default")
  sku         String    @unique
  /// Optional override of product price / MRP (paise).
  price       Int?
  mrp         Int?
  /// Available (sellable) stock.
  stock       Int       @default(0)
  /// Units sold and not returned.
  soldCount   Int       @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cartItems   CartItem[]
  orderItems  OrderItem[]
  movements   InventoryMovement[]

  @@index([productId, position])
}

/// Inventory ledger: every stock change is recorded here.
model InventoryMovement {
  id         String                @id @default(cuid())
  variantId  String
  variant    ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type       InventoryMovementType
  /// Signed change to available stock (0 for damaged / return-to-supplier records).
  delta      Int
  quantity   Int
  orderId    String?
  note       String?
  actorId    String?
  createdAt  DateTime              @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  title      String?
  body       String?
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

model WishlistItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, productId])
}

model ProductView {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewCount  Int      @default(1)
  viewedAt   DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

// ─────────────────────────────── Cart ───────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Hashed guest cart token (cookie) for shoppers who are not logged in.
  guestToken String?    @unique
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id         String          @id @default(cuid())
  cartId     String
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([cartId, variantId])
}

// ─────────────────────────────── Orders ───────────────────────────────

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  customerName     String
  email            String
  phone            String
  /// Snapshot of the delivery address at the time of ordering.
  shippingAddress  Json
  pincode          String
  city             String
  state            String
  status           OrderStatus
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PENDING)
  stockState       StockState    @default(NONE)
  /// All amounts in paise.
  subtotal         Int
  discount         Int           @default(0)
  shippingFee      Int           @default(0)
  codFee           Int           @default(0)
  total            Int
  gstAmount        Int           @default(0)
  couponCode       String?
  couponId         String?
  coupon           Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  /// Set when something needs a human (oversold late payment, refund failure, etc.).
  needsAttention   String?
  cancelReason     String?
  customerNote     String?
  paidAt           DateTime?
  confirmedAt      DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  paymentExpiresAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items            OrderItem[]
  payments         Payment[]
  refunds          Refund[]
  events           OrderEvent[]
  shipment         ShippingInformation?
  returns          ReturnRequest[]
  couponUsage      CouponUsage?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([paymentMethod, createdAt])
  @@index([createdAt])
  @@index([pincode])
  @@index([phone])
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  name             String
  variantName      String?
  sku              String
  imageUrl         String?
  quantity         Int
  /// Snapshots in paise at time of purchase.
  unitPrice        Int
  unitMrp          Int
  unitCost         Int
  unitShippingCost Int
  unitOtherCost    Int
  gstRate          Int
  lineTotal        Int
  returnedQuantity Int            @default(0)

  @@index([orderId])
  @@index([productId])
}

/// Order timeline entries.
model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String
  message    String
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

model ShippingInformation {
  id                 String    @id @default(cuid())
  orderId            String    @unique
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// "manual" today; courier integrations (e.g. shiprocket) can plug in later.
  provider           String    @default("manual")
  courier            String?
  trackingId         String?
  trackingUrl        String?
  estimatedDelivery  DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  /// Actual shipping spend in paise if known (overrides per-product estimate in profit).
  actualCost         Int?
  /// Return / RTO shipping spend in paise.
  returnCost         Int?
  updatedAt          DateTime  @updatedAt

  @@index([trackingId])
}

// ─────────────────────────────── Payments ───────────────────────────────

/// One row per payment attempt. An online order may have several attempts (retry after failure).
model Payment {
  id                   String               @id @default(cuid())
  orderId              String
  order                Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                 @relation(fields: [userId], references: [id])
  method               PaymentMethod
  provider             String               @default("razorpay")
  razorpayOrderId      String?              @unique
  razorpayPaymentId    String?              @unique
  amount               Int
  currency             String               @default("INR")
  status               PaymentStatus        @default(PENDING)
  /// Raw status reported by the gateway (created / authorized / captured / failed / refunded).
  gatewayStatus        String?
  gatewayMethod        String?
  failureReason        String?
  /// Gateway fee + tax in paise, as reported by Razorpay.
  gatewayFee           Int?
  refundedAmount       Int                  @default(0)
  signatureVerified    Boolean              @default(false)
  reconciliationStatus ReconciliationStatus @default(UNCHECKED)
  reconciliationNote   String?
  gatewaySnapshot      Json?
  lastCheckedAt        DateTime?
  paidAt               DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  refunds              Refund[]

  @@index([orderId])
  @@index([status, createdAt])
  @@index([reconciliationStatus])
}

model Refund {
  id                String       @id @default(cuid())
  orderId           String
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId         String
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  returnId          String?
  returnRequest     ReturnRequest? @relation(fields: [returnId], references: [id], onDelete: SetNull)
  mode              RefundMode
  razorpayRefundId  String?      @unique
  amount            Int
  status            RefundStatus @default(PENDING)
  reason            String?
  reference         String?
  failureReason     String?
  initiatedById     String?
  processedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([orderId])
  @@index([status])
}

/// Razorpay webhook log — the unique event id guarantees idempotent processing.
model WebhookEvent {
  id           String    @id @default(cuid())
  provider     String    @default("razorpay")
  eventId      String    @unique
  event        String
  payload      Json
  status       String    @default("RECEIVED")
  error        String?
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?

  @@index([event, receivedAt])
}

// ─────────────────────────────── Returns ───────────────────────────────

model ReturnRequest {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  status        ReturnStatus    @default(REQUESTED)
  reason        String
  details       String?
  adminNote     String?
  refundAmount  Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         ReturnItem[]
  refunds       Refund[]

  @@index([orderId])
  @@index([status, createdAt])
}

model ReturnItem {
  id           String           @id @default(cuid())
  returnId     String
  returnRequest ReturnRequest   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId  String
  quantity     Int
  condition    ReturnCondition?

  @@index([returnId])
}

// ─────────────────────────────── Coupons ───────────────────────────────

model Coupon {
  id           String        @id @default(cuid())
  code         String        @unique
  description  String?
  type         DiscountType
  /// Percentage (1-100) for PERCENTAGE, paise for FIXED.
  value        Int
  minOrder     Int           @default(0)
  maxDiscount  Int?
  expiresAt    DateTime?
  usageLimit   Int?
  perUserLimit Int           @default(1)
  usedCount    Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  usages       CouponUsage[]
  orders       Order[]
}

model CouponUsage {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([couponId, userId])
}

// ─────────────────────────────── Notifications ───────────────────────────────

/// In-app notifications (customer inbox and admin notification centre).
model Notification {
  id         String               @id @default(cuid())
  audience   NotificationAudience
  userId     String?
  user       User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      String
  title      String
  body       String
  link       String?
  dedupeKey  String               @unique
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  @@index([audience, userId, readAt])
  @@index([audience, createdAt])
}

/// Outbound message log for external channels (email / SMS / WhatsApp). Unique key prevents duplicates.
model NotificationDelivery {
  id          String              @id @default(cuid())
  dedupeKey   String              @unique
  event       String
  channel     NotificationChannel
  recipient   String
  subject     String?
  body        String
  status      DeliveryStatus      @default(PENDING)
  provider    String?
  providerRef String?
  error       String?
  userId      String?
  orderId     String?
  attempts    Int                 @default(0)
  createdAt   DateTime            @default(now())
  sentAt      DateTime?

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([status])
}

// ─────────────────────────────── Admin / support ───────────────────────────────

model CustomerNote {
  id          String     @id @default(cuid())
  customerId  String
  customer    User       @relation("NoteCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  authorId    String
  author      User       @relation("NoteAuthor", fields: [authorId], references: [id])
  type        NoteType   @default(NOTE)
  status      NoteStatus @default(OPEN)
  orderId     String?
  body        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([customerId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId, createdAt])
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

/// Singleton store configuration (id = "store").
model StoreSettings {
  id                       String          @id @default("store")
  storeName                String          @default("Buyontime")
  tagline                  String?         @default("Everything you need, delivered on time.")
  logoUrl                  String?
  contactEmail             String          @default("support@example.com")
  contactPhone             String          @default("")
  storeAddress             String          @default("")
  gstin                    String?
  legalName                String?
  grievanceOfficerName     String?
  grievanceOfficerEmail    String?
  // Payments
  onlinePaymentEnabled     Boolean         @default(true)
  codEnabled               Boolean         @default(true)
  codFee                   Int             @default(0)
  codMaxOrderValue         Int?
  codMinOrderValue         Int             @default(0)
  codBlockedPincodes       String[]        @default([])
  codMarkPaidOnDelivery    Boolean         @default(false)
  mixedCartPolicy          MixedCartPolicy @default(SPLIT_ORDERS)
  paymentWindowMinutes     Int             @default(30)
  // Inventory
  inventoryPolicy          InventoryPolicy @default(RESERVE_AT_CHECKOUT)
  defaultLowStockThreshold Int             @default(5)
  // Shipping
  freeShippingThreshold    Int             @default(49900)
  standardShippingFee      Int             @default(4900)
  estimatedDeliveryDays    Int             @default(5)
  unserviceablePincodes    String[]        @default([])
  // Returns
  returnWindowDays         Int             @default(7)
  // Profit engine
  gstMode                  GstMode         @default(NOT_REGISTERED)
  claimInputTaxCredit      Boolean         @default(false)
  /// Razorpay fee estimate in basis points (236 = 2.36% incl. GST) when actual fee unknown.
  gatewayFeeBps            Int             @default(236)
  packagingCostPerOrder    Int             @default(0)
  codCollectionCharge      Int             @default(0)
  /// Expected % of open COD orders that come back (RTO) — used as an estimate provision.
  codRtoRatePct            Int             @default(0)
  // Customers
  vipLifetimeSpend         Int             @default(1000000)
  // Notifications
  emailNotifications       Boolean         @default(true)
  smsNotifications         Boolean         @default(false)
  whatsappNotifications    Boolean         @default(false)
  updatedAt                DateTime        @updatedAt
}
