# ─────────────────────────────────────────────────────────────────────────────
# Buyontime — environment variables
# Copy to .env for local development. On Vercel, add these under
# Project → Settings → Environment Variables. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL. On Vercel use a pooled URL for DATABASE_URL (e.g. Neon/Supabase pooler,
# add ?pgbouncer=true&connection_limit=1 for PgBouncer) and the direct URL for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buyontime"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/buyontime"

# Public URL of the site, no trailing slash (used in emails, sitemap, Open Graph).
# On Vercel this falls back to the production domain automatically if unset.
APP_URL="http://localhost:3000"

# Session signing secret — random string, at least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# ── Razorpay (https://dashboard.razorpay.com/app/keys) ──
# Use rzp_test_… keys until your account is activated, then switch to rzp_live_….
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""            # server only — never exposed to the browser
NEXT_PUBLIC_RAZORPAY_KEY_ID=""    # same value as RAZORPAY_KEY_ID (safe to expose)
RAZORPAY_WEBHOOK_SECRET=""        # the secret you set when creating the webhook

# ── Image storage: Cloudinary (https://console.cloudinary.com) ──
# Without these, uploads use the local disk driver, which only works in development.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="buyontime"

# ── Email: Resend (https://resend.com) — optional but recommended ──
RESEND_API_KEY=""
EMAIL_FROM="Buyontime <orders@yourdomain.com>"

# ── SMS / WhatsApp — optional webhook adapters (POST {to, text, channel}) ──
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_TOKEN=""

# Protects /api/cron/expire-orders (Vercel Cron sends it automatically as a Bearer token).
CRON_SECRET=""

# ── Seed passwords (required when seeding a production database) ──
SEED_ADMIN_PASSWORD=""
SEED_SUPPLIER_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""

# ── Optional tuning ──
# Registration / login attempts allowed per IP (many Indian mobile users share one IP).
RATE_LIMIT_REGISTER_PER_HOUR="30"
RATE_LIMIT_LOGIN_PER_IP="60"
